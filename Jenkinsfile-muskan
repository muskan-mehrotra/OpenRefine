pipeline {
  agent any

  options {
    timestamps()
  }

  tools {
    maven 'Maven3'   // change only if your Maven tool has a different name
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build (skip packaging)') {
      steps {
        sh '''
          echo "Java version:"
          java -version || true

          echo "Maven version:"
          mvn -version

          # Build all modules except 'packaging'
          mvn -B -DskipTests clean install -pl '!packaging' -am
        '''
      }
    }

    stage('Test (skip packaging)') {
      steps {
        sh "mvn -B test -pl '!packaging' -am"
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: '**/target/*.jar'
    }
    success {
      echo 'Pipeline completed successfully'
    }
    failure {
      echo 'Pipeline failed'
    }
  }
}