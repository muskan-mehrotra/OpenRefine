pipeline {
  agent any

  options {
    timestamps()
  }

  // Uses the Maven tool you configured in Jenkins:
  // Manage Jenkins -> Tools -> Maven installations
  tools {
    maven 'Maven3'   // <-- CHANGE this if your Maven tool has a different name
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build (skip packaging)') {
      steps {
        sh '''
          echo "Java version:"
          java -version || true

          echo "Maven version:"
          mvn -version

          # Build all modules except 'packaging' (mac app bundling fails in CI)
          mvn -B -DskipTests clean install -pl '!packaging' -am
        '''
      }
    }

    stage('Test (skip packaging)') {
      steps {
        # Run tests; exclude packaging module as well
        sh "mvn -B test -pl '!packaging' -am"
      }
      post {
        always {
          // Publish JUnit test results in Jenkins
          junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: '**/target/*.jar'
    }
    success {
      echo 'Pipeline completed successfully'
    }
    failure {
      echo 'Pipeline failed'
    }
  }
}