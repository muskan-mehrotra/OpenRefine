pipeline {
  agent any

  options {
    timestamps()
  }

  // Use Maven configured in Jenkins (Manage Jenkins -> Tools)
  tools {
    maven 'Maven3'   // <-- must match the Maven tool name in Jenkins
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build') {
      steps {
        sh '''
          echo "Java version:"
          java -version || true

          echo "Maven version (from Jenkins tool):"
          mvn -version

          mvn -B -DskipTests clean compile
        '''
      }
    }

    stage('Test') {
      steps {
        sh 'mvn -B test'
      }
      post {
        always {
          // Publish JUnit results to Jenkins "Tests" tab
          junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
        }
      }
    }

    stage('Package') {
      steps {
        sh 'mvn -B -DskipTests package'
      }
    }
  }

  post {
    always {
      archiveArtifacts allowEmptyArchive: true, artifacts: '**/target/*.jar'
    }
    success {
      echo 'Pipeline completed successfully'
    }
    failure {
      echo 'Pipeline failed'
    }
  }
}